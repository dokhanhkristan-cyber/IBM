{
  "name": "pitchpulse-global-wallet",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {"directory":"./public", "binding":"ASSETS", "run_worker_first":["/api/*"]},
  "durable_objects": {"bindings": [{"name":"GAME","class_name":"GlobalGame"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["GlobalGame"]}]
}
